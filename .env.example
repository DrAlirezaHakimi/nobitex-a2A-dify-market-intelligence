# PRIVATE: .env must not be shared, committed, or served by a web server.
MARKET_MODE=demo
# A2A backend key; copy this value into Dify Studio's secret A2A_API_KEY environment variable.
API_KEY=REPLACE_WITH_RANDOM_GENERATED_32PLUS_CHAR_SECRET
# Your currently active ngrok HTTPS public URL, without trailing slash.
PUBLIC_BASE_URL=
# Dify Workflow app API key from Studio > Access Point > API Key. Not the A2A key.
DIFY_API_KEY=
DIFY_API_BASE=https://api.dify.ai/v1
MARKET_TTL=70
MAX_PARALLEL=12
MAX_DEEP=300
